{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "belanjawan",
  "compatibility_date": "2026-10-01",
  // Static files only, no Worker script. `npm run deploy` builds into .deploy/belanjawan/,
  // so asset paths match the URL path under harithilmi.com/belanjawan/.
  "assets": { "directory": "./.deploy" },
  // Zone routes run before the harithilmi-com Custom Domain Worker (tuju), so only
  // these paths come here. /belanjawan redirects to /belanjawan/ (default auto-trailing-slash).
  "routes": [
    { "pattern": "harithilmi.com/belanjawan", "zone_name": "harithilmi.com" },
    { "pattern": "harithilmi.com/belanjawan/*", "zone_name": "harithilmi.com" },
    // UAT copy of the next version, built into .deploy/belanjawan-uat/.
    { "pattern": "harithilmi.com/belanjawan-uat", "zone_name": "harithilmi.com" },
    { "pattern": "harithilmi.com/belanjawan-uat/*", "zone_name": "harithilmi.com" }
  ]
}
